SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# Microsoft Entra ID (Outlook Calendar) — Client ID e redirect URI não são
# segredos (públicos por natureza no fluxo OAuth com PKCE de app nativo).
# O Client Secret NUNCA vai aqui — só como variável de ambiente da Edge
# Function microsoft-oauth-exchange/microsoft-oauth-refresh no Supabase.
MICROSOFT_CLIENT_ID=SEU_CLIENT_ID_DO_APP_REGISTRATION_AQUI
MICROSOFT_REDIRECT_URI=com.bussola.app://outlookauth
